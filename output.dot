digraph Organization {
    layout=neato;
    overlap=false;
    splines=curved;
    node [style=filled, fillcolor=white];
    edge [fontsize=10, len=1.5];

    Person [shape=ellipse, style="solid", fontname="Arial Bold", label="Person"];
    attr_Person_id [shape=ellipse, style=solid, peripheries=1, fontname="Arial", fontsize=10, label=<<u>id : uuid</u>>];
    Person -> attr_Person_id [dir=none, color="gray40"];
    attr_Person_name [shape=ellipse, style=solid, peripheries=1, fontname="Arial", fontsize=10, label=<name : string>];
    Person -> attr_Person_name [dir=none, color="gray40"];
    Employee [shape=ellipse, style="solid", fontname="Arial Bold", label="Employee"];
    attr_Employee_salary [shape=ellipse, style=solid, peripheries=1, fontname="Arial", fontsize=10, label=<salary : decimal>];
    Employee -> attr_Employee_salary [dir=none, color="gray40"];
    attr_Employee_hire_date [shape=ellipse, style=solid, peripheries=1, fontname="Arial", fontsize=10, label=<hire_date : date>];
    Employee -> attr_Employee_hire_date [dir=none, color="gray40"];
    Manager [shape=ellipse, style="solid", fontname="Arial Bold", label="Manager"];
    attr_Manager_bonus [shape=ellipse, style=solid, peripheries=1, fontname="Arial", fontsize=10, label=<bonus : decimal>];
    Manager -> attr_Manager_bonus [dir=none, color="gray40"];
    attr_Manager_department [shape=ellipse, style=solid, peripheries=1, fontname="Arial", fontsize=10, label=<department : string>];
    Manager -> attr_Manager_department [dir=none, color="gray40"];

    manages_rel [shape=diamond, style=filled, fillcolor=lightgray, peripheries=1, label="manages"];
    attr_rel_manages_assigned_date [shape=ellipse, peripheries=1, fontsize=9, label="assigned_date : date"];
    manages_rel -> attr_rel_manages_assigned_date [dir=none, style=dashed, color="gray40"];
    Manager -> manages_rel [taillabel="1", labeldistance=1.5, dir=none, color="black"];
    Employee -> manages_rel [taillabel="N", labeldistance=1.5, dir=none, color="black"];
    reports_to_rel [shape=diamond, style=filled, fillcolor=lightgray, peripheries=1, label="reports_to"];
    Employee -> reports_to_rel [taillabel="N", labeldistance=1.5, dir=none, color="black"];
    Manager -> reports_to_rel [taillabel="1", labeldistance=1.5, dir=none, color="black"];

    Employee -> Person [arrowhead=onormal, label="is-a"];
    Manager -> Employee [arrowhead=onormal, label="is-a"];
}
