schema Hospital

entity Doctor {
    doc_id : uuid primary
    name : string not null
}

entity Patient {
    patient_id : uuid primary
    name : string not null
}

entity Consultation {
    consultation_id : uuid primary
    description : string not null
}

relationship administers(Doctor one, Patient many, Consultation many) {
    date_time : datetime not null
    notes : string
}
